generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Brand {
  LOLARK
  MUNDHANAI
}

enum SalesChannel {
  ONLINE
  POP_UP_STALL
}

enum StockMovementType {
  OPENING
  SALE
  RESTOCK
  CORRECTION
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  sku            String          @unique @db.VarChar(32)
  name           String          @db.VarChar(120)
  brand          Brand
  category       String          @db.VarChar(80)
  price          Decimal         @db.Decimal(12, 2)
  stockQuantity  Int             @default(0) @map("stock_quantity")
  isActive       Boolean         @default(true) @map("is_active")
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([brand, isActive])
  @@index([category])
  @@map("products")
}

model Order {
  id             String          @id @default(uuid()) @db.Uuid
  totalAmount    Decimal         @map("total_amount") @db.Decimal(12, 2)
  salesChannel   SalesChannel    @map("sales_channel")
  items          OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([salesChannel, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  productName     String  @map("product_name") @db.VarChar(120)
  brandAtCheckout Brand   @map("brand_at_checkout")
  quantity        Int
  priceAtCheckout Decimal @map("price_at_checkout") @db.Decimal(12, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([brandAtCheckout])
  @@index([productId])
  @@map("order_items")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  orderId        String?           @map("order_id") @db.Uuid
  type           StockMovementType
  quantityChange Int               @map("quantity_change")
  balanceAfter   Int               @map("balance_after")
  note           String?           @db.VarChar(240)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("stock_movements")
}
